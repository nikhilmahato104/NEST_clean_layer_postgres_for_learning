{
  "name": "micro-service-postgres",
  "version": "0.0.1",
  "description": "Student CRUD learning project: NestJS clean architecture with PostgreSQL (TypeORM)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node_modules/pm2/bin/pm2-runtime start ecosystem.config.js",
    "start-pm2": "pm2 start ecosystem.config.js",
    "start:dev": "env-cmd -f .env.dev nest start --watch",
    "start:production": "env-cmd -f .env.prod nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start-dev": "cross-env NODE_ENV=dev node ./dist/main.js",
    "start-prod": "cross-env NODE_ENV=prod node ./dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.812.0",
    "@aws-sdk/client-secrets-manager": "^3.987.0",
    "@aws-sdk/credential-providers": "^3.987.0",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.22",
    "archiver": "^7.0.1",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.7.8",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cross-env": "^7.0.3",
    "csv-parser": "^3.2.0",
    "docx": "^9.1.0",
    "docx-template": "^2.2.5",
    "docx-templates": "^4.13.0",
    "docxtemplater": "^3.54.1",
    "env-cmd": "^10.1.0",
    "express": "^4.21.0",
    "firebase-admin": "^13.6.0",
    "fs": "^0.0.1-security",
    "html-pdf-node": "^1.0.8",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "katex": "^0.16.22",
    "mathjax-node": "^2.1.1",
    "mongodb": "^6.20.0",
    "mongoose": "^8.6.1",
    "multer": "^1.4.5-lts.1",
    "nest-winston": "^1.10.2",
    "nodemailer": "^6.9.15",
    "path": "^0.12.7",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "pizzip": "^3.1.7",
    "pm2": "^6.0.8",
    "puppeteer": "^24.17.1",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.3",
    "string-similarity": "^4.0.4",
    "typeorm": "^0.3.28",
    "winston": "^3.17.0",
    "winston-cloudwatch": "^6.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.19.24",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
